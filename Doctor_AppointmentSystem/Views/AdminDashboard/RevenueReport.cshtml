@model Doctor_AppointmentSystem.ViewModels.RevenueReportViewModel

@{
    ViewData["Title"] = "Sunshine Hospital";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";

    string mode = (Model.Mode ?? "month").Trim().ToLowerInvariant();
}

<style>
    /* Page header */
    .page-top {
        margin: 6px 0 18px;
    }
    .page-title {
        font-size: 28px;
        font-weight: 800;
        color: #0f172a;
        margin: 0;
    }
    .page-subtitle {
        margin: 6px 0 0;
        color: #64748b;
        font-weight: 500;
    }

    /* Card */
    .rev-card {
        background: rgba(255,255,255,0.85);
        border: 1px solid rgba(210,220,255,0.85);
        border-radius: 18px;
        box-shadow: 0 18px 50px rgba(15, 23, 42, 0.08);
        padding: 18px 18px 14px;
        backdrop-filter: blur(10px);
    }

    /* Filters */
    .rev-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        margin-bottom: 14px;
    }

    .rev-select, .rev-date {
        height: 42px;
        padding: 0 12px;
        border-radius: 12px;
        border: 1px solid rgba(205, 215, 255, 1);
        background: #fff;
        color: #0f172a;
        font-weight: 600;
        outline: none;
        min-width: 150px;
    }

    .rev-date {
        min-width: 170px;
    }

    .btn-primary {
        height: 42px;
        padding: 0 16px;
        border-radius: 12px;
        border: none;
        background: #4f7dff;
        color: #fff;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 10px 18px rgba(79,125,255,0.20);
        transition: transform 0.08s ease;
    }
    .btn-primary:active { transform: translateY(1px); }

    .btn-secondary {
        height: 40px;
        padding: 0 14px;
        border-radius: 12px;
        border: 1px solid rgba(205, 215, 255, 1);
        background: #fff;
        color: #0f172a;
        font-weight: 700;
        cursor: pointer;
    }

    /* Table */
    .rev-table-wrap {
        overflow: auto;
        border-radius: 14px;
        border: 1px solid rgba(226,232,240,0.9);
        background: #fff;
    }

    .rev-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 820px;
    }

    .rev-table thead th {
        text-align: left;
        font-size: 13px;
        letter-spacing: .02em;
        color: #334155;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 12px 14px;
        font-weight: 800;
    }

    .rev-table tbody td {
        padding: 14px;
        border-bottom: 1px solid #f1f5f9;
        color: #0f172a;
        font-weight: 600;
        vertical-align: middle;
    }

    .rev-table tbody tr:hover td {
        background: #f9fbff;
    }

    .rev-empty {
        padding: 18px 14px;
        color: #64748b;
        text-align: center;
        font-weight: 700;
    }

    .money {
        font-weight: 900;
        color: #0f172a;
        white-space: nowrap;
    }

    /* Total + export */
    .rev-footer {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-top: 12px;
    }

    .rev-total {
        display: flex;
        align-items: baseline;
        gap: 10px;
        padding: 12px 14px;
        border-radius: 14px;
        border: 1px solid rgba(205,215,255,1);
        background: rgba(79,125,255,0.06);
    }

    .rev-total span {
        color: #334155;
        font-weight: 800;
    }

    .rev-total strong {
        font-size: 18px;
        font-weight: 900;
        color: #0f172a;
    }

    .rev-export {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    /* Little helper text */
    .range-chip {
        display: inline-flex;
        gap: 8px;
        align-items: center;
        padding: 10px 12px;
        border-radius: 14px;
        background: rgba(255,255,255,0.7);
        border: 1px solid rgba(205,215,255,1);
        color: #334155;
        font-weight: 800;
    }
</style>

@* <div class="page-top">
    <h1 class="page-title">Sunshine Hospital</h1>
    <p class="page-subtitle">Revenue Report</p>
</div> *@

<div class="rev-card">

    <h1 class="page-title">Revenue Report</h1>

    <!-- ================= FILTERS ================= -->
    <form method="get"
          asp-controller="AdminDashboard"
          asp-action="RevenueReport"
          class="rev-filters"
          id="revFilterForm">

        <!-- Mode -->
        @{
            var mode = (Model.Mode ?? "month").Trim().ToLowerInvariant();
            var currentYear = DateTime.UtcNow.Year;
        }

        <!-- Mode -->
        <select name="mode" class="rev-select" id="modeSelect">
            @if (mode == "month")
            {
                <option value="month" selected="selected">Month</option>
            }
            else
            {
                <option value="month">Month</option>
            }

            @if (mode == "last7")
            {
                <option value="last7" selected="selected">Last 7 Days</option>
            }
            else
            {
                <option value="last7">Last 7 Days</option>
            }

            @if (mode == "last15")
            {
                <option value="last15" selected="selected">Last 15 Days</option>
            }
            else
            {
                <option value="last15">Last 15 Days</option>
            }

            @if (mode == "custom")
            {
                <option value="custom" selected="selected">Custom</option>
            }
            else
            {
                <option value="custom">Custom</option>
            }
        </select>

        <!-- Month -->
        <select name="month" class="rev-select" id="monthSelect">
            @for (int m = 1; m <= 12; m++)
            {
                var monthName = new DateTime(2000, m, 1).ToString("MMMM");

                if (Model.Month == m)
                {
                    <option value="@m" selected="selected">@monthName</option>
                }
                else
                {
                    <option value="@m">@monthName</option>
                }
            }
        </select>

        <!-- Year -->
        <select name="year" class="rev-select" id="yearSelect">
            @for (int y = currentYear - 3; y <= currentYear + 1; y++)
            {
                if (Model.Year == y)
                {
                    <option value="@y" selected="selected">@y</option>
                }
                else
                {
                    <option value="@y">@y</option>
                }
            }
        </select>

        <select name="doctorProfileId" class="rev-select">
            <option value="">All Doctors</option>
            @foreach (var d in Model.Doctors)
            {
                <option value="@d.Id" selected="@(Model.DoctorProfileId == d.Id)">
                    @d.Name
                </option>
            }
        </select>




     

        <!-- Custom range -->
        <input type="date"
               name="start"
               value="@Model.Start"
               class="rev-date"
               id="startDate"
               max="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />

        <input type="date"
               name="end"
               value="@Model.End"
               class="rev-date"
               id="endDate"
               max="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />

        <button type="submit" class="btn-primary">Apply</button>

        <span class="range-chip">
            Range:
            <span>
                @Model.FromUtc.ToString("dd MMM yyyy") - @Model.ToUtc.ToString("dd MMM yyyy")
            </span>
        </span>

    </form>

    <!-- ================= TABLE ================= -->
    <div class="rev-table-wrap">
        <table class="rev-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Doctor</th>
                    <th>Patient</th>
                    <th>Payment Method</th>
                    <th>Amount</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Rows == null || !Model.Rows.Any())
                {
                    <tr>
                        <td colspan="5" class="rev-empty">
                            No payments found in this range.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>@row.PaidAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>@row.DoctorName</td>
                            <td>@row.PatientName</td>
                            <td>@row.Method</td>
                            <td class="money">৳@row.Amount</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- ================= TOTAL + EXPORT ================= -->
    <div class="rev-footer">
        <div class="rev-total">
            <span>Total Revenue</span>
            <strong>৳@Model.Total</strong>
        </div>

        <div class="rev-export">
            <form method="get" asp-controller="AdminDashboard" asp-action="RevenueReportPdf">
                <input type="hidden" name="mode" value="@Model.Mode" />
                <input type="hidden" name="year" value="@Model.Year" />
                <input type="hidden" name="month" value="@Model.Month" />
                <input type="hidden" name="start" value="@Model.Start" />
                <input type="hidden" name="end" value="@Model.End" />
                <input type="hidden" name="doctorProfileId" value="@Model.DoctorProfileId" />

                <button type="submit" class="btn-secondary">Export PDF</button>
            </form>
        </div>


    </div>

</div>



<script>
    // show/hide inputs based on mode + prevent invalid ranges + block future dates
    (function () {
        const modeSelect = document.getElementById("modeSelect");
        const monthSelect = document.getElementById("monthSelect");
        const yearSelect = document.getElementById("yearSelect");
        const startDate = document.getElementById("startDate");
        const endDate = document.getElementById("endDate");

        function applyModeUI() {
            const mode = (modeSelect.value || "month").toLowerCase();

            const isMonth = mode === "month";
            const isCustom = mode === "custom";

            monthSelect.style.display = isMonth ? "inline-flex" : "none";
            yearSelect.style.display = isMonth ? "inline-flex" : "none";

            startDate.style.display = isCustom ? "inline-flex" : "none";
            endDate.style.display = isCustom ? "inline-flex" : "none";
        }

        // ✅ Added: prevent selecting future dates
        function applyNoFutureDates() {
            const today = new Date();
            const yyyy = today.getFullYear();
            const mm = String(today.getMonth() + 1).padStart(2, "0");
            const dd = String(today.getDate()).padStart(2, "0");
            const maxDate = `${yyyy}-${mm}-${dd}`;

            startDate.max = maxDate;
            endDate.max = maxDate;
        }

        // ✅ Added: prevent start/end conflicts
        function syncStartEndConstraints() {
            // End must be >= start
            endDate.min = startDate.value ? startDate.value : "";

            // Start must be <= end (but don't remove the "no future" max)
            if (endDate.value) {
                startDate.max = endDate.value;
            }
        }

        // ✅ Added: normalize invalid inputs (manual typing / edge cases)
        function normalizeStartEndIfNeeded() {
            // If end < start, snap end to start
            if (startDate.value && endDate.value && endDate.value < startDate.value) {
                endDate.value = startDate.value;
            }

            // Clamp any future manual values back to today
            const maxDate = startDate.max; // both should share same max after applyNoFutureDates()
            if (startDate.value && startDate.value > maxDate) startDate.value = maxDate;
            if (endDate.value && endDate.value > maxDate) endDate.value = maxDate;
        }

        modeSelect.addEventListener("change", applyModeUI);

        // ✅ Added listeners for conflict + future-date handling
        startDate.addEventListener("change", function () {
            syncStartEndConstraints();
            normalizeStartEndIfNeeded();
        });

        endDate.addEventListener("change", function () {
            syncStartEndConstraints();
            normalizeStartEndIfNeeded();
        });

        applyModeUI();

        // ✅ Initialize on load (handles prefilled values)
        applyNoFutureDates();
        syncStartEndConstraints();
        normalizeStartEndIfNeeded();
    })();
</script>
