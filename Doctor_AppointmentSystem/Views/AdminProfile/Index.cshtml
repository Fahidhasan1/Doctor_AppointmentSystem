@model Doctor_AppointmentSystem.ViewModels.AdminProfileViewModel

@{
    ViewData["Title"] = "Sunshine Hospital";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";

    var fullName = $"{Model.FirstName} {Model.LastName}".Trim();
    var initial = (!string.IsNullOrWhiteSpace(fullName) ? fullName.Trim()[0].ToString().ToUpper() : "A");
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success-soft">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-danger-soft">
        @TempData["ErrorMessage"]
    </div>
}

<div class="card">
    <div class="card-title-row">
        <div>
            <h3>My Profile</h3>
            <div class="card-title-sub">
                
            </div>
        </div>
    </div>

    <div class="profile-grid">
        <!-- LEFT PANEL -->
        <div class="profile-left">
            <div class="profile-photo-wrap">
                @if (!string.IsNullOrWhiteSpace(Model.ProfileImagePath))
                {
                    <img src="@Url.Content(Model.ProfileImagePath)" class="profile-photo" alt="Profile" />
                }
                else
                {
                    <div class="profile-photo-fallback">@initial</div>
                }
            </div>

            <div class="profile-name">@fullName</div>
            <div class="profile-role">System Admin</div>
            <div class="profile-email">@Model.Email</div>

            <!-- Change Photo (patient style) -->
            <form asp-controller="AdminProfile"
                  asp-action="ChangePhoto"
                  method="post"
                  enctype="multipart/form-data"
                  class="profile-photo-form">
                @Html.AntiForgeryToken()

                <input type="file"
                       name="profilePhoto"
                       id="profilePhotoInput"
                       accept=".jpg,.jpeg,.png,.webp"
                       hidden />

                <button type="button" class="btn btn-outline-primary" id="changePhotoBtn">
                    Change Photo
                </button>

                <button type="submit" class="btn btn-outline-primary" id="uploadPhotoBtn" style="display:none;">
                    Upload
                </button>
            </form>

            <!-- LEFT DETAILS -->
            <div class="profile-side-details">
                <div class="profile-side-title">Personal Details</div>
                <div class="profile-side-item"><b>Phone:</b> @(!string.IsNullOrWhiteSpace(Model.PhoneNumber) ? Model.PhoneNumber : "-")</div>
                <div class="profile-side-item"><b>Date of Birth:</b> @(Model.DateOfBirth.HasValue? Model.DateOfBirth.Value.ToString("dd MMM yyyy") : "-")</div>
                <div class="profile-side-item"><b>Gender:</b> @(!string.IsNullOrWhiteSpace(Model.Gender) ? Model.Gender : "-")</div>

                <div class="profile-side-title mt-3">Office Details</div>
                <div class="profile-side-item"><b>Office Phone:</b> @(!string.IsNullOrWhiteSpace(Model.OfficePhoneNo) ? Model.OfficePhoneNo : "-")</div>
                <div class="profile-side-item"><b>Office Room:</b> @(!string.IsNullOrWhiteSpace(Model.OfficeRoomNo) ? Model.OfficeRoomNo : "-")</div>

                <div class="profile-side-title mt-3">Address</div>
                <div class="profile-side-item">@(!string.IsNullOrWhiteSpace(Model.Address) ? Model.Address : "-")</div>
            </div>
        </div>

        <!-- RIGHT PANEL -->
        <div class="profile-right">
            @* NOTE: keep asp-action same as your controller POST.
               If your admin save POST is Index, keep Index. If it is MyProfile, change it. *@
            <form asp-controller="AdminProfile" asp-action="Index" method="post">
                @Html.AntiForgeryToken()

                <div class="form-grid-2">
                    <div class="form-group">
                        <label asp-for="FirstName"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="LastName"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <input value="@Model.Email" class="form-control" disabled />
                    </div>

                    <div class="form-group">
                        <label asp-for="PhoneNumber"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="DateOfBirth">Date of Birth</label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Gender"></label>
                        <select asp-for="Gender" class="form-control">
                            <option value="">Select</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="OfficePhoneNo">Office Phone</label>
                        <input asp-for="OfficePhoneNo" class="form-control" />
                        <span asp-validation-for="OfficePhoneNo" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="OfficeRoomNo">Office Room No</label>
                        <input asp-for="OfficeRoomNo" class="form-control" />
                        <span asp-validation-for="OfficeRoomNo" class="text-danger"></span>
                    </div>

                    <div class="form-group form-group-full">
                        <label asp-for="Address"></label>
                        <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-save-profile">
                    Save Profile
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const btn = document.getElementById('changePhotoBtn');
            const input = document.getElementById('profilePhotoInput');
            const uploadBtn = document.getElementById('uploadPhotoBtn');

            if (!btn || !input) return;

            btn.addEventListener('click', () => input.click());

            input.addEventListener('change', () => {
                uploadBtn.style.display = (input.files && input.files.length) ? "inline-flex" : "none";
            });
        })();
    </script>
}
