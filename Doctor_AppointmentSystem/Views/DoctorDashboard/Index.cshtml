@model Doctor_AppointmentSystem.ViewModels.DoctorDashboardViewModel
@using System.Text.Json
@using Doctor_AppointmentSystem.Enums

@{
    ViewData["Title"] = "Doctor Dashboard";
    Layout = "~/Views/Shared/_Layout_Doctor.cshtml";
}

<!-- ===== TOP STATS ===== -->
<div class="stats-grid">
    <!-- TODAY'S APPOINTMENTS -->
    <div class="card stat-card"
         data-url="@Url.Action("Index", "DoctorAppointments", new { filter = "Today", fromCard = true })">
        <div class="stat-card-header">
            <div>
                <div class="stat-title">Today's Appointments</div>
                <div class="stat-value">@Model.TodaysAppointments</div>
            </div>
        </div>
        <div class="stat-sub">Scheduled for today</div>
    </div>

    <!-- UPCOMING APPOINTMENTS -->
    <div class="card stat-card"
         data-url="@Url.Action("Index", "DoctorAppointments", new { filter = "Upcoming", fromCard = true })">
        <div class="stat-card-header">
            <div>
                <div class="stat-title">Upcoming</div>
                <div class="stat-value">@Model.UpcomingAppointments</div>
            </div>
        </div>
        <div class="stat-sub">Future confirmed visits</div>
    </div>

    <!-- PATIENTS TREATED -->
    <div class="card stat-card"
         data-url="@Url.Action("Index", "DoctorPatientsTreated", new { fromCard = true })">
        <div class="stat-card-header">
            <div>
                <div class="stat-title">Patients Treated</div>
                <div class="stat-value">@Model.TotalPatientsTreated</div>
            </div>
        </div>
        <div class="stat-sub">Unique patients (all time)</div>
    </div>

    <!-- MONTHLY REVENUE (✅ now opens DoctorRevenue/RevenueReport) -->
    <div class="card stat-card"
         data-url="@Url.Action("RevenueReport", "DoctorRevenue", new { mode = "month" })">
        <div class="stat-card-header">
            <div>
                <div class="stat-title">Monthly Revenue</div>
                <div class="stat-value">৳@Model.MonthlyRevenue.ToString("0")</div>
            </div>
        </div>
        <div class="stat-sub">Paid appointments this month</div>
    </div>
</div>

<!-- ===== CHARTS ===== -->
<div class="charts-grid">
    <!-- Monthly Revenue Trend -->
    <div class="card">
        <div class="card-title-row">
            <div>
                <h3>Monthly Revenue Trend</h3>
                @* <div class="card-title-sub">This doctor's earnings by month</div> *@
            </div>
            <span class="revenue-change-badge">Current year</span>
        </div>
        <div class="chart-container">
            <canvas id="doctorRevenueChart"></canvas>
        </div>
    </div>

    <!-- Appointment Status Breakdown -->
    <div class="card">
        <div class="card-title-row">
            <div>
                <h3>Appointment Status Breakdown</h3>
                @* <div class="card-title-sub">Today's paid appointments by status</div> *@
            </div>
        </div>
        <div class="chart-container">
            <canvas id="doctorStatusChart"></canvas>
        </div>
    </div>
</div>

<!-- ===== LOWER GRID ===== -->
<div class="lower-grid">
    <!-- Today's Appointments -->
    <div class="card">
        <div class="card-title-row">
            <div>
                <h3>Today's Appointments</h3>
                @* <div class="card-title-sub">Manage and update appointment status</div> *@
            </div>

            <a class="link-small"
               asp-controller="DoctorAppointments"
               asp-action="Index"
               asp-route-filter="Today"
               asp-route-fromCard="true">
                View All
            </a>
        </div>

        <table class="table-simple">
            <thead>
                <tr>
                    <th>TIME</th>
                    <th>PATIENT</th>
                    <th>PHONE</th>
                    <th>PAYMENT</th>
                    <th>STATUS</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.TodaysAppointmentsList != null && Model.TodaysAppointmentsList.Any())
                {
                    foreach (var appt in Model.TodaysAppointmentsList)
                    {
                        var statusClass = appt.Status switch
                        {
                            AppointmentStatus.Completed => "status-pill status-pill--completed",
                            AppointmentStatus.Cancelled => "status-pill status-pill--cancelled",
                            AppointmentStatus.NoShow => "status-pill status-pill--noshow",
                            AppointmentStatus.Rescheduled => "status-pill status-pill--rescheduled",
                            _ => "status-pill status-pill--confirmed"
                        };

                        <tr>
                            <td>@appt.AppointmentDateTime.ToString("hh:mm tt")</td>
                            <td>@appt.PatientName</td>
                            <td>@(string.IsNullOrWhiteSpace(appt.PatientPhone) ? "—" : appt.PatientPhone)</td>

                            <td>
                                <div>@appt.PaymentDisplay</div>
                                @if (appt.PaidAmount.HasValue)
                                {
                                    <div class="text-muted" style="font-size:12px;">
                                        @appt.Currency@appt.PaidAmount.Value.ToString("0")
                                    </div>
                                }
                            </td>

                            <td>
                                <span class="@statusClass">@appt.Status</span>
                            </td>

                            <td class="table purely-actions">
                                @* Only show buttons for TODAY + Confirmed *@
                                @if (appt.Status == AppointmentStatus.Confirmed && appt.AppointmentDateTime.Date == DateTime.Today)
                                {
                                    <div class="appt-actions">
                                        <form asp-controller="DoctorAppointments"
                                              asp-action="MarkCompleted"
                                              method="post"
                                              style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@appt.AppointmentId" />
                                            <input type="hidden" name="filter" value="Today" />
                                            <button type="submit" class="btn-pill btn-pill--outline-primary">Complete</button>
                                        </form>

                                        <form asp-controller="DoctorAppointments"
                                              asp-action="MarkNoShow"
                                              method="post"
                                              style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@appt.AppointmentId" />
                                            <input type="hidden" name="filter" value="Today" />
                                            <button type="submit" class="btn-pill btn-pill--outline-danger">No Show</button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="appt-dash">—</span>
                                }
                            </td>
                           

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-muted">No appointments scheduled for today.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Availability & Off Days -->
    <div class="card">
        <div class="card-title-row">
            <div>
                <h3>Availability &amp; Off Days</h3>
                @* <div class="card-title-sub">Time slots and unavailable dates</div> *@
            </div>
            <a class="link-small"
               asp-controller="DoctorSchedule"
               asp-action="ManageTimeSlots">
                Edit Slots
            </a>
        </div>

        <div class="availability-grid">
            <!-- Today's Slots -->
            <div>
                <div class="activity-revenue-label">Today's Slots</div>

                @if (Model.TodaySlots != null && Model.TodaySlots.Any())
                {
                    foreach (var slot in Model.TodaySlots)
                    {
                        <div class="slot-row">
                            <div class="slot-main">
                                @* ✅ FIX: avoid double time (Label already contains time) *@
                                <div class="slot-label">@slot.Label</div>
                            </div>

                            <div class="slot-badge">
                                @slot.SlotsRemaining slots left
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted">No schedule defined for today.</div>
                }
            </div>

            <!-- Upcoming Off Days -->
            <div class="availability-offdays">
                @* ✅ right aligned, same color as "Edit Slots" *@
                <div class="card-title-row" style="margin-bottom:10px;">
                    <div class="activity-revenue-label" style="margin:0;">Upcoming Off Days</div>

                    <a class="link-small"
                       asp-controller="DoctorUnavailability"
                       asp-action="Index">
                        Manage Off Days
                    </a>
                </div>

                @if (Model.UpcomingOffDays != null && Model.UpcomingOffDays.Any())
                {
                    foreach (var off in Model.UpcomingOffDays)
                    {
                        <div class="offday-row">
                            <div class="offday-date">@off.Date.ToString("dd MMM yyyy")</div>
                            <div class="offday-reason">
                                @(string.IsNullOrWhiteSpace(off.Reason) ? "—" : off.Reason)
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted">No upcoming off days configured.</div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ✅ Make stat cards clickable via data-url
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".stat-card[data-url]").forEach(card => {
                card.addEventListener("click", () => {
                    const url = card.getAttribute("data-url");
                    if (url) window.location.href = url;
                });
            });
        });

        // ===== REVENUE LINE CHART =====
        const doctorRevLabels = @Html.Raw(JsonSerializer.Serialize(Model.RevenueMonthLabels));
        const doctorRevValues = @Html.Raw(JsonSerializer.Serialize(Model.RevenueMonthValues));

        const doctorRevCanvas = document.getElementById('doctorRevenueChart');
        if (doctorRevCanvas && window.Chart) {
            const ctx = doctorRevCanvas.getContext('2d');

            const maxRev = doctorRevValues.length
                ? Math.max(...doctorRevValues.map(v => Number(v) || 0))
                : 0;
            const yMax = maxRev > 0 ? maxRev * 1.2 : 1;

            const gradient = ctx.createLinearGradient(0, 0, 0, 230);
            gradient.addColorStop(0, 'rgba(79, 125, 255, 0.32)');
            gradient.addColorStop(1, 'rgba(79, 125, 255, 0.02)');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: doctorRevLabels,
                    datasets: [{
                        label: 'Revenue',
                        data: doctorRevValues,
                        fill: true,
                        backgroundColor: gradient,
                        borderColor: 'rgba(79, 125, 255, 1)',
                        borderWidth: 2,
                        pointRadius: 3,
                        tension: 0.3
                    }]
                },
                options: {
                    plugins: { legend: { display: false } },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { color: '#7b88b0', font: { size: 11 } }
                        },
                        y: {
                            beginAtZero: true,
                            suggestedMin: 0,
                            suggestedMax: yMax,
                            grid: { color: 'rgba(123, 136, 176, 0.15)' },
                            ticks: { color: '#7b88b0', font: { size: 11 } }
                        }
                    }
                }
            });
        }

        // ===== STATUS DONUT CHART (Tooltip shows % on hover) =====
        const statusCanvas = document.getElementById('doctorStatusChart');
        if (statusCanvas && window.Chart) {
            const sctx = statusCanvas.getContext('2d');

            const statusLabels = ['Remaining Today', 'Completed', 'No Show'];
            const statusValues = [
                Number(@Model.TodayRemainingCount),
                Number(@Model.TodayCompletedCount),
                Number(@Model.TodayNoShowCount)
            ];

            const total = statusValues.reduce((sum, v) => sum + (Number(v) || 0), 0);

            new Chart(sctx, {
                type: 'doughnut',
                data: {
                    labels: statusLabels,
                    datasets: [{
                        data: statusValues,
                        backgroundColor: [
                            'rgba(255, 184, 76, 0.9)',
                            'rgba(84, 201, 139, 0.9)',
                            'rgba(255, 104, 120, 0.9)'
                        ],
                        borderWidth: 0
                    }]
                },
                options: {
                    cutout: '70%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                usePointStyle: true,
                                boxWidth: 8,
                                boxHeight: 8
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    const label = context.label || '';
                                    const value = Number(context.parsed) || 0;
                                    const pct = total > 0 ? ((value / total) * 100) : 0;
                                    return `${label}: ${value} (${pct.toFixed(1)}%)`;
                                }
                            }
                        }
                    }
                }
            });
        }
    </script>
}
