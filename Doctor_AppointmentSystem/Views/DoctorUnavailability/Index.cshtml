@model Doctor_AppointmentSystem.ViewModels.DoctorUnavailabilityIndexViewModel

@* @{
    ViewData["Title"] = "Sunshine Hospital";
    Layout = "_Layout_Doctor";
} *@
@{
    ViewData["Title"] = "Sunshine Hospital";
    Layout = "_Layout_Doctor";
    var today = DateTime.Today;
}


<link rel="stylesheet" href="~/css/doctor-unavailability.css" asp-append-version="true" />

<div class="unavail-page">
    <div class="unavail-card">

        <div class="unavail-header">
            <div>
                <h3 class="unavail-title">Closed / Unavailable Dates</h3>
                <p class="unavail-subtitle">Select a date when you are unavailable (full day).</p>
            </div>

          @*   <a asp-controller="DoctorDashboard" asp-action="Index" class="back-link">← Back</a> *@
        </div>

        <form asp-action="Add" method="post" class="unavail-form">
            @Html.AntiForgeryToken()

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Unavailable Date</label>
                    @* <input asp-for="UnavailableDate" type="date" class="form-control" /> *@
                    <input asp-for="UnavailableDate" type="date" class="form-control"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" />

                </div>

                <div class="form-group">
                    <label class="form-label">Reason (optional)</label>
                    <input asp-for="Reason" type="text" class="form-control" placeholder="e.g., Leave / Conference" />
                </div>

                <div class="form-group form-actions">
                    <button type="submit" class="btn-save">Add</button>
                </div>
            </div>
        </form>

        <div class="unavail-list">
            <h5 class="list-title">Unavailable Dates</h5>

            @if (Model.Items == null || !Model.Items.Any())
            {
                <div class="empty-state">No unavailable dates added yet.</div>
            }
            else
            {
                <table class="unavail-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Reason</th>
                            <th style="width:120px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Date.ToString("dddd, MMM dd, yyyy")</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Reason) ? "-" : item.Reason)</td>
                                @* <td>
                                    <form asp-action="Remove" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn-remove">Remove</button>
                                    </form>
                                </td> *@

                                <td>
                                    @if (item.Date < today)
                                    {
                                        <span>-</span>
                                    }
                                    else
                                    {
                                        <form asp-action="Remove" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn-remove">Remove</button>
                                        </form>
                                    }
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

    </div>
</div>
