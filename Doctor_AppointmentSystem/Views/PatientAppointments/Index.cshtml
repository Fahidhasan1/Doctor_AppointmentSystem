@model Doctor_AppointmentSystem.ViewModels.PatientAppointmentsIndexViewModel

@{
    ViewData["Title"] = "My Appointments";
    Layout = "~/Views/Shared/_Layout_Patient.cshtml";

    var currentFilter = (Model.Filter ?? "").Trim().ToLowerInvariant();
    bool isActive(string f) => currentFilter == (f ?? "");

    // ✅ Payments mode (Digital Payments card)
    bool isPaymentsView = currentFilter == "payments";

    string prettyTitle = "My Appointments";
    if (Model.FromCard)
    {
        prettyTitle = currentFilter switch
        {
            "upcoming" => "Upcoming Appointments",
            "completed" => "Completed Visits",
            "cancelled" => "Cancelled / Missed",
            "payments" => "Digital Payments", // ✅ NEW
            _ => "My Appointments"
        };
    }

    ViewData["Title"] = prettyTitle;
}

<link rel="stylesheet" href="~/css/receptionist-appointments.css" asp-append-version="true" />

<div class="appt-page">
    <div class="appt-card">
        <div class="appt-header">
            <div>
                <h2 class="appt-title">@prettyTitle</h2>

                @if (!Model.FromCard)
                {
                    <div class="appt-subtitle">View and track your appointments.</div>

                    <div class="appt-tabs">
                        <a class="appt-tab @(isActive("") ? "active" : "")"
                           asp-controller="PatientAppointments"
                           asp-action="Index"
                           asp-route-filter="">
                            All
                        </a>

                        <a class="appt-tab @(isActive("upcoming") ? "active" : "")"
                           asp-controller="PatientAppointments"
                           asp-action="Index"
                           asp-route-filter="upcoming">
                            Upcoming
                        </a>

                        <a class="appt-tab @(isActive("completed") ? "active" : "")"
                           asp-controller="PatientAppointments"
                           asp-action="Index"
                           asp-route-filter="completed">
                            Completed
                        </a>

                        <a class="appt-tab @(isActive("cancelled") ? "active" : "")"
                           asp-controller="PatientAppointments"
                           asp-action="Index"
                           asp-route-filter="cancelled">
                            Cancelled / Missed
                        </a>

                        @* ✅ Optional: show payments tab in normal view too *@
                        <a class="appt-tab @(isActive("payments") ? "active" : "")"
                           asp-controller="PatientAppointments"
                           asp-action="Index"
                           asp-route-filter="payments">
                            Digital Payments
                        </a>
                    </div>
                }
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info">@TempData["InfoMessage"]</div>
        }

        @if (Model.Appointments == null || !Model.Appointments.Any())
        {
            <div class="appt-empty">
                No appointments found.
            </div>
        }
        else
        {
            <div class="appt-table-wrap">
                <table class="appt-table">
                    <thead>
                        @if (isPaymentsView)
                        {
                            <tr>
                                <th>Appointment</th>
                                <th>Doctor</th>
                                <th>Payment</th>
                                <th class="appt-actions-col">Receipt</th>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <th>Date &amp; Time</th>
                                <th>Doctor</th>
                                <th>Specialty</th>
                                <th>Status</th>
                                <th>Payment</th>
                                <th class="appt-actions-col">Action</th>
                            </tr>
                        }
                    </thead>

                    <tbody>
                        @foreach (var a in Model.Appointments)
                        {
                            // ✅ In payments view, show ONLY PAID items
                            if (isPaymentsView && !(a.IsPaid && a.PaidPaymentId.HasValue))
                            {
                                continue;
                            }

                            <tr>
                                @if (isPaymentsView)
                                {
                                    <td>
                                        <div class="appt-dt">
                                            <div class="appt-dt-date">@a.AppointmentDateTime.ToString("dd MMM yyyy")</div>
                                            <div class="appt-dt-time">@a.AppointmentDateTime.ToString("hh:mm tt") (@a.DurationMinutes min)</div>
                                        </div>
                                    </td>

                                    <td>@a.DoctorName</td>

                                    <td>
                                        <div class="appt-pay">
                                            <div class="appt-pay-status">@a.PaymentDisplay</div>
                                            @if (a.Amount > 0)
                                            {
                                                <div class="appt-pay-amount">৳@a.Amount.ToString("0")</div>
                                            }
                                            else
                                            {
                                                <div class="appt-pay-amount">—</div>
                                            }
                                        </div>
                                    </td>

                                    <td class="appt-actions-col">
                                        @if (a.IsPaid && a.PaidPaymentId.HasValue)
                                        {
                                            <a asp-controller="PatientReceipts"
                                               asp-action="Download"
                                               asp-route-paymentId="@a.PaidPaymentId"
                                               class="appt-btn appt-btn-primary appt-btn-link">
                                                Download Receipt
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="appt-dash">—</span>
                                        }
                                    </td>
                                }
                                else
                                {
                                    <td>
                                        <div class="appt-dt">
                                            <div class="appt-dt-date">@a.AppointmentDateTime.ToString("dd MMM yyyy")</div>
                                            <div class="appt-dt-time">@a.AppointmentDateTime.ToString("hh:mm tt") (@a.DurationMinutes min)</div>
                                        </div>
                                    </td>

                                    <td>@a.DoctorName</td>

                                    <td>@(string.IsNullOrWhiteSpace(a.SpecialtyName) ? "-" : a.SpecialtyName)</td>

                                    <td>@a.Status</td>

                                    <td>
                                        <div class="appt-pay">
                                            <div class="appt-pay-status">@a.PaymentDisplay</div>

                                            @if (a.Amount > 0)
                                            {
                                                <div class="appt-pay-amount">৳@a.Amount.ToString("0")</div>
                                            }
                                            else
                                            {
                                                <div class="appt-pay-amount">—</div>
                                            }
                                        </div>
                                    </td>

                                    <td class="appt-actions-col">
                                        @if (a.IsPaid && a.PaidPaymentId.HasValue)
                                        {
                                            <a asp-controller="PatientReceipts"
                                               asp-action="Download"
                                               asp-route-paymentId="@a.PaidPaymentId"
                                               class="appt-btn appt-btn-primary appt-btn-link">
                                                Download Receipt
                                            </a>
                                        }
                                        else if (a.CanShowActions)
                                        {
                                            <div class="appt-actions">
                                                @if (a.CanPay)
                                                {
                                                    <form asp-controller="PatientAppointments"
                                                          asp-action="Pay"
                                                          method="post"
                                                          class="appt-action-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@a.Id" />
                                                        <input type="hidden" name="filter" value="@Model.Filter" />

                                                        <button type="submit" class="appt-btn appt-btn-primary">
                                                            Pay
                                                        </button>
                                                    </form>
                                                }

                                                @if (a.CanCancel)
                                                {
                                                    <form asp-controller="PatientAppointments"
                                                          asp-action="Cancel"
                                                          method="post"
                                                          class="appt-action-form cancel-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@a.Id" />
                                                        <input type="hidden" name="filter" value="@Model.Filter" />

                                                        <button type="button"
                                                                class="appt-btn appt-btn-danger js-cancel-btn"
                                                                data-doctor="@a.DoctorName"
                                                                data-datetime="@a.AppointmentDateTime.ToString("dd MMM yyyy, hh:mm tt")">
                                                            Cancel
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="appt-dash">—</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Cancel Modal -->
<div id="cancelModal" class="modal-backdrop" aria-hidden="true">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="cancelModalTitle">
        <div class="modal-header">
            <h3 id="cancelModalTitle" class="modal-title">Cancel Appointment</h3>
            <button type="button" class="modal-close" id="cancelModalCloseBtn">×</button>
        </div>

        <div class="modal-body">
            <p class="modal-text">Are you sure you want to cancel this appointment?</p>

            <div class="modal-details">
                <div><span>Doctor:</span> <strong id="cancelDoctorText">—</strong></div>
                <div><span>Date & Time:</span> <strong id="cancelDateTimeText">—</strong></div>
            </div>

            <div class="modal-warning">
                Cancelling will free the slot so other patients can book it.
            </div>
        </div>

        <div class="modal-actions">
            <button type="button" class="appt-btn" id="cancelModalBackBtn">No, keep it</button>
            <button type="button" class="appt-btn appt-btn-danger" id="cancelModalConfirmBtn">
                Yes, cancel appointment
            </button>
        </div>
    </div>
</div>

<script>
    (function () {
        const modal = document.getElementById('cancelModal');
        const closeBtn = document.getElementById('cancelModalCloseBtn');
        const backBtn = document.getElementById('cancelModalBackBtn');
        const confirmBtn = document.getElementById('cancelModalConfirmBtn');

        const doctorText = document.getElementById('cancelDoctorText');
        const dateTimeText = document.getElementById('cancelDateTimeText');

        let formToSubmit = null;

        function openModal() {
            modal.classList.add('show');
            modal.setAttribute('aria-hidden', 'false');
            document.body.classList.add('modal-open');
        }

        function closeModal() {
            modal.classList.remove('show');
            modal.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('modal-open');
            formToSubmit = null;
        }

        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.js-cancel-btn');
            if (!btn) return;

            e.preventDefault();
            e.stopPropagation();

            formToSubmit = btn.closest('form');

            doctorText.textContent = btn.getAttribute('data-doctor') || '—';
            dateTimeText.textContent = btn.getAttribute('data-datetime') || '—';

            openModal();
        });

        confirmBtn.addEventListener('click', function () {
            if (formToSubmit) {
                formToSubmit.submit();
            }
        });

        [closeBtn, backBtn].forEach(x => x.addEventListener('click', closeModal));

        modal.addEventListener('click', function (e) {
            if (e.target === modal) closeModal();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeModal();
        });
    })();
</script>
