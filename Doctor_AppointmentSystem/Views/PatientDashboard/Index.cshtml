@model Doctor_AppointmentSystem.ViewModels.PatientDashboardViewModel

@{
    ViewData["Title"] = "Patient Dashboard";
    Layout = "~/Views/Shared/_Layout_Patient.cshtml";
}

<!-- ============ TOP STATS (same structure as Admin/Doctor) ============ -->
<div class="stats-grid">

    <!-- UPCOMING APPOINTMENTS -->
    <a asp-controller="PatientAppointments"
       asp-action="Index"
       asp-route-filter="upcoming"
       asp-route-fromCard="true"
       class="card stat-card stat-card-link">
        <div class="stat-card-header">
            <div>
                <div class="stat-title">Upcoming Appointments</div>
                <div class="stat-value">@Model.UpcomingAppointments</div>
            </div>
            <div class="stat-icon">
                <i class="fa-regular fa-calendar"></i>
            </div>
        </div>
        <div class="stat-sub">Within next 7 days</div>
    </a>

    <!-- COMPLETED VISITS -->
    <a asp-controller="PatientAppointments"
       asp-action="Index"
       asp-route-filter="completed"
       asp-route-fromCard="true"
       class="card stat-card stat-card-link">
        <div class="stat-card-header">
            <div>
                <div class="stat-title">Completed Visits</div>
                <div class="stat-value">@Model.CompletedVisits</div>
            </div>
            <div class="stat-icon">
                <i class="fa-regular fa-circle-check"></i>
            </div>
        </div>
        <div class="stat-sub">All time completed</div>
    </a>

    <!-- CANCELLED / MISSED -->
    <a asp-controller="PatientAppointments"
       asp-action="Index"
       asp-route-filter="cancelled"
       asp-route-fromCard="true"
       class="card stat-card stat-card-link">
        <div class="stat-card-header">
            <div>
                <div class="stat-title">Cancelled / Missed</div>
                <div class="stat-value">@Model.CancelledOrMissed</div>
            </div>
            <div class="stat-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
        </div>
        <div class="stat-sub">Cancelled or no-show</div>
    </a>

    <!-- DIGITAL PAYMENTS -->
    <a asp-controller="PatientAppointments"
       asp-action="Index"
       asp-route-filter="payments"
       asp-route-fromCard="true"
       class="card stat-card stat-card-link">
        <div class="stat-card-header">
            <div>
                <div class="stat-title">Digital Payments</div>
                <div class="stat-value">৳@Model.DigitalPaymentsTotal.ToString("0")</div>
            </div>
            <div class="stat-icon">
                <i class="fa-regular fa-credit-card"></i>
            </div>
        </div>
        <div class="stat-sub">Paid via bKash &amp; cards</div>
    </a>

</div>


<!-- ====== FIND YOUR DOCTOR SECTION (Patient Dashboard) ====== -->
<section class="doctor-search-section" id="find-doctor">
    <h2 class="doctor-search-title">Find Your Doctor</h2>

    <!-- FILTER BAR -->
    <div class="doctor-search-card">
        <form asp-action="Index"
              asp-controller="PatientDashboard"
              method="get"
              class="doctor-search-form"
              id="patientDoctorFilterForm">

            <!-- Doctor Name (live search) -->
            <div class="doctor-search-field">
                <label>Doctor Name</label>
                <input type="text"
                       name="doctorNameFilter"
                       value="@Model.DoctorNameFilter"
                       placeholder="e.g. Rahman" />
            </div>

            <!-- Specialty -->
            <div class="doctor-search-field">
                <label>Specialty</label>
                <select name="specialtyIdFilter">
                    @foreach (var option in Model.SpecialtyOptions)
                    {
                        <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">
                            @option.Text
                        </option>
                    }
                </select>
            </div>

            <!-- Experience -->
            <div class="doctor-search-field">
                <label>Experience</label>
                <select name="experienceFilter">
                    @foreach (var option in Model.ExperienceOptions)
                    {
                        <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">
                            @option.Text
                        </option>
                    }
                </select>
            </div>

            <!-- Reset -->
            <div class="doctor-search-field doctor-search-actions">
                <label>&nbsp;</label>
                <a asp-action="Index"
                   asp-controller="PatientDashboard"
                   class="btn-reset-full">
                    Reset Filters
                </a>
            </div>
        </form>
    </div>

    <!-- DOCTOR CARDS (3 per row, 6 per page) -->
    <div class="doctor-card-grid doctor-card-grid-three">
        @if (Model.Doctors != null && Model.Doctors.Any())
        {
            foreach (var d in Model.Doctors)
            {
                <div class="doctor-card-large">
                    <!-- Photo -->
                    <div class="doctor-card-photo">
                        @if (!string.IsNullOrWhiteSpace(d.ProfileImagePath))
                        {
                            <img src="@Url.Content(d.ProfileImagePath)" alt="@d.FullName" />
                        }
                        else
                        {
                            var initial = string.IsNullOrWhiteSpace(d.FullName)
                            ? "?"
                            : d.FullName.Trim()[0].ToString().ToUpper();

                            <div class="doctor-photo-fallback">@initial</div>
                        }
                    </div>

                    <!-- Info -->
                    <div class="doctor-info">
                        <h3 class="doctor-name">@d.FullName</h3>
                        <div class="doctor-specialty">@d.PrimarySpecialty</div>

                        <div class="doctor-meta">@d.ExperienceText</div>

                        @if (!string.IsNullOrWhiteSpace(d.ClinicInfo))
                        {
                            <div class="doctor-meta">@d.ClinicInfo</div>
                        }

                        @* Qualification (NEW) *@
                        @if (!string.IsNullOrWhiteSpace(d.Qualification))
                        {
                            <div class="doctor-qualification">@d.Qualification</div>
                        }
                    </div>

                    <!-- Footer -->
                    <div class="doctor-card-footer">
                        <div class="doctor-fee">
                            <span class="doctor-fee-label">Visiting Charge:</span>
                            <span class="doctor-fee-value">৳@d.VisitCharge.ToString("0")</span>
                        </div>

                        <a asp-controller="Appointment"
                           asp-action="DoctorSlots"
                           asp-route-doctorProfileId="@d.DoctorProfileId"
                           class="doctor-card-button">
                            View Slots
                        </a>


                    </div>
                </div>
            }
        }
        else
        {
            <div class="doctor-empty">
                No doctors found for the selected filters.
            </div>
        }
    </div>

    <!-- PAGINATION -->
    @if (Model.TotalPages > 1)
    {
        <nav class="doctor-pagination">
            <ul class="doctor-pagination-list">
                @if (Model.CurrentPage > 1)
                {
                    <li>
                        <a asp-action="Index"
                           asp-controller="PatientDashboard"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-doctorNameFilter="@Model.DoctorNameFilter"
                           asp-route-specialtyIdFilter="@Model.SpecialtyIdFilter"
                           asp-route-experienceFilter="@Model.ExperienceFilter">
                            ‹ Prev
                        </a>
                    </li>
                }

                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="@(Model.CurrentPage == p ? "active" : "")">
                        <a asp-action="Index"
                           asp-controller="PatientDashboard"
                           asp-route-page="@p"
                           asp-route-doctorNameFilter="@Model.DoctorNameFilter"
                           asp-route-specialtyIdFilter="@Model.SpecialtyIdFilter"
                           asp-route-experienceFilter="@Model.ExperienceFilter">
                            @p
                        </a>
                    </li>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li>
                        <a asp-action="Index"
                           asp-controller="PatientDashboard"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-doctorNameFilter="@Model.DoctorNameFilter"
                           asp-route-specialtyIdFilter="@Model.SpecialtyIdFilter"
                           asp-route-experienceFilter="@Model.ExperienceFilter">
                            Next ›
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
</section>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('patientDoctorFilterForm');
            if (!form) return;

            const debounce = (fn, delay) => {
                let timer;
                return (...args) => {
                    clearTimeout(timer);
                    timer = setTimeout(() => fn.apply(null, args), delay);
                };
            };

            const submitForm = () => form.submit();

            const doctorNameInput = form.querySelector('input[name="doctorNameFilter"]');
            const specialtySelect = form.querySelector('select[name="specialtyIdFilter"]');
            const experienceSelect = form.querySelector('select[name="experienceFilter"]');

            if (doctorNameInput) {
                doctorNameInput.addEventListener('input', debounce(submitForm, 400));
            }

            [specialtySelect, experienceSelect].forEach(el => {
                if (el) el.addEventListener('change', submitForm);
            });
        })();
    </script>
}




