@model Doctor_AppointmentSystem.ViewModels.PatientReceiptViewModel
@{
    ViewData["Title"] = "Appointment Receipt";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Appointment Receipt</title>

    <style>
        @@page {
            size: A4;
            margin: 0;
        }

        body {
            margin: 0;
            padding: 0;
            background: #f3f6fb;
            font-family: Arial, Helvetica, sans-serif;
            color: #111;
        }

        .sheet {
            width: 210mm;
            min-height: 297mm;
            margin: 0 auto;
            background: #fff;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            position: relative;
        }

        .sheet-content {
            padding: 18mm 16mm;
            position: relative;
            z-index: 2;
        }

        .receipt-watermark {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1;
            pointer-events: none;
            user-select: none;
        }

            .receipt-watermark span {
                font-size: 78px;
                font-weight: 800;
                color: rgba(0,0,0,0.06);
                transform: rotate(-20deg);
                white-space: nowrap;
            }

        .header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
        }

        .hospital-name {
            font-size: 28px;
            font-weight: 800;
            margin: 0;
        }

        .subtitle {
            margin-top: 4px;
            color: #667085;
            font-size: 13px;
        }

        .receipt-meta {
            text-align: right;
            font-size: 12px;
            color: #111;
        }

            .receipt-meta strong {
                display: block;
                font-size: 12px;
            }

        .divider {
            margin: 18px 0;
            height: 1px;
            background: #e8eef7;
        }

        .section h3 {
            margin: 0 0 10px 0;
            font-size: 15px;
            color: #243b76;
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px 18px;
        }

        .item span {
            display: block;
            font-size: 12px;
            color: #667085;
            margin-bottom: 3px;
        }

        .item strong {
            font-size: 14px;
            font-weight: 700;
            color: #111;
        }

        .footer-note {
            margin-top: 18px;
            font-size: 12px;
            color: #667085;
            text-align: center;
        }

        .actions {
            margin-top: 18px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .btn {
            padding: 10px 14px;
            border-radius: 12px;
            border: 1px solid #cfd7ff;
            background: #fff;
            cursor: pointer;
            font-weight: 700;
        }

        .btn-primary {
            background: #5a63ff;
            border-color: #5a63ff;
            color: #fff;
        }

        @@media print {
            body {
                background: #fff;
            }

            .sheet {
                box-shadow: none;
            }

            .actions {
                display: none;
            }
        }
    </style>
</head>

<body>
    <div class="sheet">
        <div class="receipt-watermark">
            <span>@Model.HospitalName</span>
        </div>

        <div class="sheet-content">

            <div class="header">
                <div>
                    <h1 class="hospital-name">@Model.HospitalName</h1>
                    <div class="subtitle">Appointment Receipt / Visit Slip</div>
                </div>

                <div class="receipt-meta">
                    <strong>Receipt No: @Model.ReceiptNo</strong>
                    Issued: @Model.IssuedAt.ToString("dd MMM yyyy, hh:mm tt")
                </div>
            </div>

            <div class="divider"></div>

            <div class="section">
                <h3>Patient Information</h3>
                <div class="grid">
                    <div class="item"><span>Name</span><strong>@Model.PatientName</strong></div>

                    @if (Model.ShowPatientCode)
                    {
                        <div class="item"><span>Patient Code</span><strong>@Model.PatientCode</strong></div>
                    }

                    <div class="item">
                        <span>Phone</span>
                        <strong>@(string.IsNullOrWhiteSpace(Model.PatientPhone) ? "-" : Model.PatientPhone)</strong>
                    </div>

                    @if (Model.ShowPatientGender)
                    {
                        <div class="item">
                            <span>Gender</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.PatientGender) ? "-" : Model.PatientGender)</strong>
                        </div>
                    }
                </div>
            </div>

            <div class="divider"></div>

            <div class="section">
                <h3>Appointment Details</h3>
                <div class="grid">
                    <div class="item"><span>Doctor</span><strong>@Model.DoctorName</strong></div>
                    <div class="item"><span>Specialty</span><strong>@Model.Specialty</strong></div>
                    <div class="item"><span>Room No</span><strong>@(string.IsNullOrWhiteSpace(Model.RoomNo) ? "-" : Model.RoomNo)</strong></div>
                    <div class="item"><span>Date &amp; Time</span><strong>@Model.AppointmentDateTime.ToString("dd MMM yyyy, hh:mm tt")</strong></div>
                </div>
            </div>

            <div class="divider"></div>

            <div class="section">
                <h3>Payment Information</h3>
                <div class="grid">
                    <div class="item"><span>Amount</span><strong>৳@Model.Amount.ToString("0")</strong></div>
                    <div class="item"><span>Method</span><strong>@Model.Method</strong></div>
                    <div class="item"><span>Provider</span><strong>@(string.IsNullOrWhiteSpace(Model.ProviderName) ? "-" : Model.ProviderName)</strong></div>
                    <div class="item"><span>Transaction ID</span><strong>@(string.IsNullOrWhiteSpace(Model.TransactionId) ? "-" : Model.TransactionId)</strong></div>
                </div>
            </div>

            @if (Model.ShowIssuer)
            {
                <div class="divider"></div>

                <div class="section">
                    <h3>Issued By</h3>
                    <div class="grid">
                        <div class="item">
                            <span>@Model.IssuerRole</span>
                            <strong>@Model.IssuedBy</strong>
                        </div>

                        <div class="item">
                            <span>Receptionist ID</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.IssuerId) ? "-" : Model.IssuerId)</strong>
                        </div>

                        <div class="item">
                            <span>Counter No</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.IssuerCounterNo) ? "-" : Model.IssuerCounterNo)</strong>
                        </div>

                        <div class="item">
                            <span>Note</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.Note) ? "-" : Model.Note)</strong>
                        </div>
                    </div>
                </div>
            }

            <div class="footer-note">
                Please arrive at least <strong>10 minutes early</strong> and bring this receipt for verification.
            </div>

            <div class="actions">
                <button class="btn" onclick="history.back()">Back</button>
                <button class="btn btn-primary" onclick="window.print()">Print / Save PDF</button>
            </div>

        </div>
    </div>
</body>
</html>
