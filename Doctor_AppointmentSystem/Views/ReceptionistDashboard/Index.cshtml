@model Doctor_AppointmentSystem.ViewModels.ReceptionistDashboardViewModel
@using Doctor_AppointmentSystem.Enums
@using System.Linq

@{
    ViewData["Title"] = "Receptionist Dashboard";
    Layout = "~/Views/Shared/_Layout_Receptionist.cshtml";
}

<!-- ============ TOP STATS (now clickable like buttons) ============ -->
<div class="stats-grid">

    <!-- MY TOTAL BOOKED -->
    <div class="card stat-card stat-card-button"
         role="button"
         tabindex="0"
         data-url="@Url.Action("Index", "ReceptionistAppointments", new { filter = "all", fromCard = true })">

        <div class="stat-card-header">
            <div>
                <div class="stat-title">MY TOTAL BOOKED</div>
                <div class="stat-value">@Model.TotalAppointments</div>
            </div>
            <div class="stat-icon">
                <i class="fa-regular fa-calendar"></i>
            </div>
        </div>
        <div class="stat-sub">Booked by you (all time)</div>
    </div>

    <!-- MY TODAY'S BOOKED -->
    <div class="card stat-card stat-card-button"
         role="button"
         tabindex="0"
         data-url="@Url.Action("Index", "ReceptionistAppointments", new { filter = "today", fromCard = true })">

        <div class="stat-card-header">
            <div>
                <div class="stat-title">MY TODAY'S BOOKED</div>
                <div class="stat-value">@Model.TodaysAppointments</div>
            </div>
            <div class="stat-icon">
                <i class="fa-regular fa-circle-check"></i>
            </div>
        </div>
        <div class="stat-sub">Booked by you today</div>
    </div>

    <!-- MY TODAY'S COLLECTION -->
    <div class="card stat-card stat-card-button"
         role="button"
         tabindex="0"
         data-url="@Url.Action("Index", "ReceptionistAppointments", new { filter = "paidtoday", fromCard = true })">

        <div class="stat-card-header">
            <div>
                <div class="stat-title">MY TODAY'S COLLECTION</div>
                <div class="stat-value">৳@Model.TodaysCollections.ToString("0")</div>
            </div>
            <div class="stat-icon">
                <i class="fa-regular fa-credit-card"></i>
            </div>
        </div>
        <div class="stat-sub">Paid today</div>
    </div>

    <!-- MY TOTAL COLLECTION -->
    <div class="card stat-card stat-card-button"
         role="button"
         tabindex="0"
         data-url="@Url.Action("Index", "ReceptionistAppointments", new { filter = "paidall", fromCard = true })">

        <div class="stat-card-header">
            <div>
                <div class="stat-title">MY TOTAL COLLECTION</div>
                <div class="stat-value">৳@Model.TotalCollections.ToString("0")</div>
            </div>
            <div class="stat-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
        </div>
        <div class="stat-sub">Paid (all time)</div>
    </div>

</div>

<!-- ====== FIND YOUR DOCTOR SECTION ====== -->
<section class="doctor-search-section" id="find-doctor">
    <h2 class="doctor-search-title">Find Your Doctor</h2>

    <!-- FILTER BAR -->
    <div class="doctor-search-card">
        <form asp-action="Index"
              asp-controller="ReceptionistDashboard"
              method="get"
              class="doctor-search-form"
              id="receptionistDoctorFilterForm">

            <!-- Doctor Name -->
            <div class="doctor-search-field">
                <label>Doctor Name</label>
                <input type="text"
                       name="doctorName"
                       value="@Model.DoctorNameFilter"
                       placeholder="e.g. Rahman" />
            </div>

            <!-- Specialty -->
            <div class="doctor-search-field">
                <label>Specialty</label>
                <select name="specialtyId">
                    @foreach (var option in Model.SpecialtyOptions)
                    {
                        <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">
                            @option.Text
                        </option>
                    }
                </select>
            </div>

            <!-- Experience -->
            <div class="doctor-search-field">
                <label>Experience</label>
                <select name="experience">
                    @foreach (var option in Model.ExperienceOptions)
                    {
                        <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">
                            @option.Text
                        </option>
                    }
                </select>
            </div>

            <!-- Reset -->
            <div class="doctor-search-field doctor-search-actions">
                <label>&nbsp;</label>
                <a asp-action="Index"
                   asp-controller="ReceptionistDashboard"
                   class="btn-reset-full">
                    Reset Filters
                </a>
            </div>
        </form>
    </div>

    <!-- DOCTOR CARDS -->
    <div class="doctor-card-grid doctor-card-grid-three">
        @if (Model.Doctors != null && Model.Doctors.Any())
        {
            foreach (var d in Model.Doctors)
            {
                <div class="doctor-card-large">
                    <!-- Photo -->
                    <div class="doctor-card-photo">
                        @if (!string.IsNullOrWhiteSpace(d.ProfileImagePath))
                        {
                            <img src="@Url.Content(d.ProfileImagePath)" alt="@d.FullName" />
                        }
                        else
                        {
                            var initial = string.IsNullOrWhiteSpace(d.FullName)
                            ? "?"
                            : d.FullName.Trim()[0].ToString().ToUpper();

                            <div class="doctor-photo-fallback">@initial</div>
                        }
                    </div>

                    <!-- Info -->
                    <div class="doctor-info">
                        <h3 class="doctor-name">@d.FullName</h3>
                        <div class="doctor-specialty">@d.PrimarySpecialty</div>

                        <div class="doctor-meta">@d.ExperienceText</div>

                        @if (!string.IsNullOrWhiteSpace(d.ClinicInfo))
                        {
                            <div class="doctor-meta">@d.ClinicInfo</div>
                        }

                        @if (!string.IsNullOrWhiteSpace(d.Qualification))
                        {
                            <div class="doctor-qualification">@d.Qualification</div>
                        }
                    </div>

                    <!-- Footer -->
                    <div class="doctor-card-footer">
                        <div class="doctor-rating">
                            <span class="doctor-rating-star">★</span>
                            <span class="doctor-rating-value">@d.AverageRating.ToString("0.0")</span>
                            <span class="doctor-rating-count">(@d.ReviewCount reviews)</span>
                        </div>

                        <a asp-controller="Appointment"
                           asp-action="DoctorSlots"
                           asp-route-doctorProfileId="@d.DoctorProfileId"
                           class="doctor-card-button">
                            View Slots
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="doctor-empty">
                No doctors found for the selected filters.
            </div>
        }
    </div>

    <!-- PAGINATION -->
    @if (Model.TotalPages > 1)
    {
        <nav class="doctor-pagination">
            <ul class="doctor-pagination-list">
                @if (Model.CurrentPage > 1)
                {
                    <li>
                        <a asp-action="Index"
                           asp-controller="ReceptionistDashboard"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-doctorName="@Model.DoctorNameFilter"
                           asp-route-specialtyId="@Model.SpecialtyIdFilter"
                           asp-route-experience="@Model.ExperienceFilter">
                            ‹ Prev
                        </a>
                    </li>
                }

                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="@(Model.CurrentPage == p ? "active" : "")">
                        <a asp-action="Index"
                           asp-controller="ReceptionistDashboard"
                           asp-route-page="@p"
                           asp-route-doctorName="@Model.DoctorNameFilter"
                           asp-route-specialtyId="@Model.SpecialtyIdFilter"
                           asp-route-experience="@Model.ExperienceFilter">
                            @p
                        </a>
                    </li>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li>
                        <a asp-action="Index"
                           asp-controller="ReceptionistDashboard"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-doctorName="@Model.DoctorNameFilter"
                           asp-route-specialtyId="@Model.SpecialtyIdFilter"
                           asp-route-experience="@Model.ExperienceFilter">
                            Next ›
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
</section>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('receptionistDoctorFilterForm');
            if (!form) return;

            const debounce = (fn, delay) => {
                let timer;
                return (...args) => {
                    clearTimeout(timer);
                    timer = setTimeout(() => fn.apply(null, args), delay);
                };
            };

            const submitForm = () => form.submit();

            const doctorNameInput = form.querySelector('input[name="doctorName"]');
            const specialtySelect = form.querySelector('select[name="specialtyId"]');
            const experienceSelect = form.querySelector('select[name="experience"]');

            if (doctorNameInput) {
                doctorNameInput.addEventListener('input', debounce(submitForm, 400));
            }

            [specialtySelect, experienceSelect].forEach(el => {
                if (el) el.addEventListener('change', submitForm);
            });

            // ✅ Make stat cards clickable like buttons
            document.querySelectorAll('.stat-card-button').forEach(card => {
                card.style.cursor = 'pointer';

                card.addEventListener('click', () => {
                    const url = card.getAttribute('data-url');
                    if (url) window.location.href = url;
                });

                // keyboard support: Enter / Space
                card.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        const url = card.getAttribute('data-url');
                        if (url) window.location.href = url;
                    }
                });
            });

        })();
    </script>
}
